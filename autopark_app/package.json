{
  "name": "autopark_app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "buffer": "^6.0.3",
    "expo": "~58.0.20",
    "expo-asset": "~58.0.18",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.16",
    "expo-file-system": "~58.0.12",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-keep-awake": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-router": "~58.0.27",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "jpeg-js": "^0.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "upng-js": "^2.1.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/upng-js": "^2.1.5",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "onnxruntime-node": "^1.24.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "parity:reference": "python -I tools/parity/make_reference.py ../autopark_vision __tests__/fixtures",
    "bundle:android": "expo export --platform android --output-dir dist-android"
  },
  "private": true,
  "jest": {
    "projects": [
      {
        "displayName": "core",
        "preset": "jest-expo/node",
        "testMatch": [
          "<rootDir>/__tests__/**/*.test.ts"
        ],
        "testEnvironment": "<rootDir>/tools/jest/nodeEnvironment.js"
      },
      {
        "displayName": "ui",
        "preset": "jest-expo/android",
        "testMatch": [
          "<rootDir>/__tests__/**/*.test.tsx"
        ]
      }
    ]
  }
}
