# Copy to .env and fill in. Never commit .env.

# Default provider for scripts/analyze.py:
#   "local" (offline CNN in models/), "mock" (offline demo data) or "ai" (Claude API).
AUTOPARK_PROVIDER=local
# AUTOPARK_LOCAL_MODEL=models/slot_classifier.onnx
# AUTOPARK_LOCAL_THRESHOLD=0.8

# Claude API key for the "ai" provider (https://platform.claude.com/).
# Alternatively run `ant auth login` and leave this unset.
ANTHROPIC_API_KEY=

# Optional overrides
AUTOPARK_AI_MODEL=claude-opus-5-5
AUTOPARK_AI_TIMEOUT_SECONDS=60
# 1 = re-run a refused request on Anthropic's recommended fallback model (server-side). 0 = off.
AUTOPARK_AI_FALLBACKS=1
